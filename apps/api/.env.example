# Copy to .env. Demo authentication impersonates one shared user: LOCAL DEVELOPMENT ONLY.
APP_ENV=local
AUTH_MODE=demo
DATABASE_URL=sqlite:///./debug_ed.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AI_PROVIDER=demo
OPENROUTER_API_KEY=
# Select an available model in your OpenRouter account; no paid model is selected implicitly.
OPENROUTER_MODEL=
AI_MAX_OUTPUT_TOKENS=1000
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
